# Public HTTPS URL the server is reachable at (no trailing slash, no /mcp)
PUBLIC_BASE_URL=https://mail.example.com

# Port the server listens on inside the container (default 8742). The compose
# file maps it automatically; normally leave it alone.
# PORT=8742

# Host port on 127.0.0.1 the container is published on (default 8742), and the
# container and Compose project names (the Compose project name defaults to the
# directory name). Change all three for a second instance (another person) on
# the same host.
# HOST_PORT=8742
# CONTAINER_NAME=mailhub-mcp
# COMPOSE_PROJECT_NAME=mailhub-mcp

# Google OAuth client of type "Web application" (used for the claude.ai login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The owner's Google login: the account you sign in to the claude.ai connector
# with. Every allowed login sees every linked mailbox, so list only yourself
# (comma-separated values are accepted, with a startup warning). Other people
# run their own instance.
ALLOWED_EMAILS=

# OAuth callback URLs MCP clients may register, comma-separated and matched
# exactly. Default: the claude.ai and claude.com connector callbacks
# (https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback).
# Setting it replaces the default, so keep the Claude entries if you still use
# claude.ai. Each entry is an https:// URL with a path, or http://localhost /
# http://127.0.0.1 (any port when none is given). No wildcards. An empty value
# is an error. See "Connecting other MCP clients" in docs/tutorial.md.
# ALLOWED_REDIRECT_URIS=

# Signs the tokens FastMCP issues and encrypts the OAuth state in ./data.
# Generate with: openssl rand -hex 32  (changing it forces a reconnect)
JWT_SIGNING_KEY=

# Maximum messages changed per account in a rolling 24 hours by modify_emails
# and modify_by_query (undo is never capped). Default 2000.
# MAX_CHANGES_PER_DAY=2000

# all (default) registers every tool; read-only registers only the read tools,
# for routines that should report but never change anything.
# TOOLS=all

# Gmail quota units each mailbox may spend per minute. Google's per-user limit
# is 6,000 units/minute for Cloud projects created since May 2026; the default
# 4800 is 80% of it. Projects with the older 15,000 limit can set 12000.
# GMAIL_UNITS_PER_MINUTE=4800

# Characters of each message body the read tools return unless a call asks for
# more (max_body_chars), at most 20000. 0 returns full bodies (up to 20,000 characters).
# MAX_BODY_CHARS=2000
